{
  "name": "freewill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate && node scripts/lock-check.cjs",
    "db:local": "mongod --replSet rs0 --port 27018 --dbpath .mongo --bind_ip 127.0.0.1 --setParameter diagnosticDataCollectionEnabled=false",
    "db:rs-init": "node --env-file=.env scripts/rs-init.mjs",
    "demurrage": "tsx --env-file=.env scripts/demurrage.ts",
    "smoke": "tsx --env-file=.env scripts/ledger-smoke.ts",
    "smoke:rcv": "tsx --env-file=.env scripts/rcv-check.ts",
    "smoke:theme": "tsx scripts/theme-check.ts",
    "db:push:prod": "node scripts/prisma-prod.mjs db push",
    "db:studio:prod": "node scripts/prisma-prod.mjs studio",
    "smoke:matches": "tsx --env-file=.env scripts/matches-check.ts",
    "smoke:pulse": "tsx --env-file=.env scripts/pulse-check.ts",
    "smoke:lottery": "tsx --env-file=.env scripts/lottery-check.ts",
    "smoke:idme": "tsx scripts/idme-check.ts",
    "smoke:seeds": "tsx scripts/seeds-check.ts",
    "smoke:hashlog": "tsx --env-file=.env scripts/hashlog-check.ts",
    "smoke:voucher": "tsx --env-file=.env scripts/voucher-check.ts",
    "smoke:jubilee": "tsx --env-file=.env scripts/jubilee-check.ts",
    "smoke:cash": "tsx --env-file=.env scripts/cash-check.ts",
    "smoke:checkpoint": "tsx --env-file=.env scripts/checkpoint-check.ts",
    "migrate:grace-cents": "tsx --env-file=.env scripts/migrate-grace-cents.ts",
    "smoke:locality": "tsx --env-file=.env scripts/locality-check.ts",
    "smoke:keys": "tsx --env-file=.env scripts/keys-check.ts",
    "smoke:security": "tsx --env-file=.env scripts/security-check.ts",
    "smoke:map": "tsx --env-file=.env scripts/map-check.ts",
    "smoke:explain": "tsx --env-file=.env scripts/explain-check.ts",
    "lock:check": "node scripts/lock-check.cjs",
    "lock:fix": "node scripts/lock-fix.cjs",
    "smoke:about": "tsx --env-file=.env scripts/about-check.ts",
    "audit:claims": "tsx --env-file-if-exists=.env scripts/audit-claims.ts",
    "smoke:audit": "tsx --env-file-if-exists=.env scripts/audit-check.ts",
    "smoke:pricing": "tsx --env-file=.env scripts/pricing-check.ts"
  },
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "next": "16.3.2",
    "prisma": "^6.19.3",
    "protomaps-leaflet": "^5.1.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typesafe-ai/sdk": "^0.6.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  }
}
