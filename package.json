{
  "name": "freewill",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:local": "mongod --replSet rs0 --port 27018 --dbpath .mongo --bind_ip 127.0.0.1",
    "db:rs-init": "node --env-file=.env scripts/rs-init.mjs",
    "demurrage": "tsx --env-file=.env scripts/demurrage.ts",
    "smoke": "tsx --env-file=.env scripts/ledger-smoke.ts",
    "smoke:rcv": "tsx --env-file=.env scripts/rcv-check.ts",
    "smoke:theme": "tsx scripts/theme-check.ts",
    "db:push:prod": "node scripts/prisma-prod.mjs db push",
    "db:studio:prod": "node scripts/prisma-prod.mjs studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.10",
    "leaflet": "^1.9.4",
    "next": "16.3.2",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  }
}
