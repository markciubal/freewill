// Freewill -- data model for a stateless, covenant-bound society.
// MongoDB via Prisma. Every collection is owned by people, not an authority.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// --- People -----------------------------------------------------------------

model User {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  username           String    @unique
  passwordHash       String
  // Bumped when the password changes or the person logs out everywhere. A
  // session token carries the version it was issued with; a mismatch means the
  // token is dead, which is the only way to revoke a signed cookie.
  sessionVersion     Int       @default(0)
  displayName        String?
  bio                String?
  locality           String // neighborhood, valley, block, mesh node... Editable on the profile.
  // A pin chosen on a map at join and movable from the profile, always rounded
  // to ~100 m. Never shown to others as a point, only as a distance. No address,
  // no GPS unless the person asks. Published records keep the pin they had.
  lat                Float
  lng                Float
  skills             String[]  @default([])
  covenantAcceptedAt DateTime
  // Mutual-credit balances. Sum across all users is always 0 for each ledger.
  graceBalance       Int       @default(0) // Grace (GRC), whole units
  hoursBalance       Int       @default(0) // Hours, stored in minutes
  // Member-held identity key (Ed25519 public key, hex). The private key lives
  // only on the member device; signatures on their vouches prove authorship.
  publicKey          String?
  keySetAt           DateTime?
  // Personal look: CSS custom properties, validated in src/lib/theme.ts. Nobody sets it for anyone else.
  theme              Json?
  // Optional ID.me attestation: when this deployment enables it, a person may
  // prove they are one distinct human. We store only the date and an HMAC of
  // the ID.me subject id (uniqueness enforced in the callback), never a name
  // or document. Effect: one extra vouch toward local verification, nothing else.
  humanVerifiedAt    DateTime?
  idmeHash           String?
  // Verified affiliations from ID.me (policy handles: nurse, responder, teacher,
  // government, military). Badges and responder-registry signal only; never power.
  affiliations       String[]  @default([])
  createdAt          DateTime  @default(now())

  vouchesGiven     Vouch[]            @relation("VouchFrom")
  vouchesReceived  Vouch[]            @relation("VouchTo")
  listings         Listing[]
  pledges          Pledge[]
  transfersOut     Transfer[]         @relation("TransferFrom")
  transfersIn      Transfer[]         @relation("TransferTo")
  stewardships     Commons[]
  commonsEntries   CommonsEntry[]
  circlesRaised    Circle[]           @relation("CircleRaisedBy")
  circlesAbout     Circle[]           @relation("CircleAbout")
  bulletins        Bulletin[]
  reflections      Reflection[]
  seedShares       SeedShare[]
  seedRequests     SeedRequest[]
  vouchersIssued   Voucher[]          @relation("VoucherIssuer")
  vouchersRedeemed Voucher[]          @relation("VoucherRedeemer")
  cashMinted       CashNote[]         @relation("CashMinter")
  cashSpent        CashNote[]         @relation("CashSpender")
  adjustments      LedgerAdjustment[]
  proposals        Proposal[]
  voterRolls       VoterRoll[]
  peersAdded       Peer[]
  peerTrust        PeerTrust[]
  peerIngests      PeerIngest[]
}

// A failed login or a join attempt, kept briefly so the same address or the
// same username cannot be hammered. Not part of the ledger: rows are pruned
// after a day. `key` is "ip:<address>" or "user:<username>".
model AuthAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  kind      String // "login" | "join" | "ingest"
  key       String
  createdAt DateTime @default(now())

  @@index([kind, key, createdAt])
}

// A vouch is the atom of trust. Standing is derived from the web of vouches,
// never granted by an office.
model Vouch {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  fromId    String   @db.ObjectId
  toId      String   @db.ObjectId
  note      String?
  signature String? // member signature over FWVOUCH1:fromId:toId, verified against from.publicKey
  createdAt DateTime @default(now())

  from User @relation("VouchFrom", fields: [fromId], references: [id])
  to   User @relation("VouchTo", fields: [toId], references: [id])

  @@unique([fromId, toId])
  @@index([toId])
  @@index([fromId])
}

// --- Exchange: barter board -------------------------------------------------

enum ListingKind {
  OFFER
  NEED
}

enum Category {
  FOOD
  WATER
  SHELTER
  MEDICAL
  SAFETY
  ENERGY
  TOOLS
  TRANSPORT
  SKILLS
  CARE
  KNOWLEDGE
  OTHER
}

enum ListingStatus {
  OPEN
  MATCHED
  FULFILLED
  WITHDRAWN
}

model Listing {
  id            String        @id @default(auto()) @map("_id") @db.ObjectId
  kind          ListingKind
  category      Category
  title         String
  description   String
  quantity      String? // "3 jars", "2 hrs/week", "one room"
  wantsInReturn String? // pure barter: what would you accept?
  priceGrace    Int? // optional Grace ask
  priceHours    Int? // optional Hours ask, in minutes
  locality      String?
  lat           Float? // copied from the owner at creation
  lng           Float?
  status        ListingStatus @default(OPEN)
  ownerId       String        @db.ObjectId
  createdAt     DateTime      @default(now())
  fulfilledAt   DateTime?

  owner       User         @relation(fields: [ownerId], references: [id])
  pledges     Pledge[]
  transfers   Transfer[]
  reflections Reflection[]

  @@index([kind, status, createdAt])
  @@index([ownerId])
}

enum PledgeStatus {
  OFFERED
  ACCEPTED
  COMPLETED
  DECLINED
}

// A pledge is "I will meet this need / take this offer". Kept pledges raise standing.
model Pledge {
  id        String       @id @default(auto()) @map("_id") @db.ObjectId
  listingId String       @db.ObjectId
  userId    String       @db.ObjectId
  message   String?
  status    PledgeStatus @default(OFFERED)
  createdAt DateTime     @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([listingId])
  @@index([userId])
}

// --- Exchange: ledgers ------------------------------------------------------

enum Ledger {
  GRACE // mutual credit, value-priced
  HOURS // time bank: one hour == one hour, for everyone
}

model Transfer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ledger    Ledger
  fromId    String   @db.ObjectId
  toId      String   @db.ObjectId
  amount    Int // GRC units, or minutes for HOURS
  memo      String?
  listingId String?  @db.ObjectId
  createdAt DateTime @default(now())

  from    User     @relation("TransferFrom", fields: [fromId], references: [id])
  to      User     @relation("TransferTo", fields: [toId], references: [id])
  listing Listing? @relation(fields: [listingId], references: [id])

  @@index([fromId, createdAt])
  @@index([toId, createdAt])
}

// --- Commons ----------------------------------------------------------------

// Shared things with a steward, not an owner: a well, a tool library, a seed bank.
model Commons {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  description       String
  category          Category
  rules             String? // how to use it well, agreed by those who use it
  locality          String?
  lat               Float?
  lng               Float?
  available         Boolean   @default(true)
  stewardId         String    @db.ObjectId
  // A steward may offer the role to another verified member, who must accept.
  // Nobody can be handed a responsibility they did not agree to.
  handoverToId      String?   @db.ObjectId
  handoverOfferedAt DateTime?
  createdAt         DateTime  @default(now())

  steward   User           @relation(fields: [stewardId], references: [id])
  entries   CommonsEntry[]
  decisions Proposal[]

  @@index([category])
}

// The record of a shared thing: who took, returned, used or tended it, in
// their own words, with no approval step. This is how a commons avoids the
// tragedy: not by rationing, but by making use visible to the people who
// share it. A NOTE about another entry is a word before a dispute: public,
// signed, and with no effect on anyone's standing.
enum CommonsEntryKind {
  TOOK
  RETURNED
  USED
  TENDED // upkeep, a check, a repair: mostly the steward, but anyone may
  NOTE
}

model CommonsEntry {
  id           String           @id @default(auto()) @map("_id") @db.ObjectId
  commonsId    String           @db.ObjectId
  userId       String           @db.ObjectId
  kind         CommonsEntryKind
  quantity     String? // "20 L", "the long saw", "an afternoon"
  note         String?
  aboutEntryId String?          @db.ObjectId // a NOTE about another entry
  createdAt    DateTime         @default(now())

  commons Commons @relation(fields: [commonsId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@index([commonsId, createdAt])
  @@index([userId])
}

// --- Circles: restorative process ------------------------------------------

enum CircleStatus {
  OPEN // raised, seeking keepers
  GATHERING // keepers present, hearing accounts
  RESOLVED
  DISMISSED
}

// A circle is how harm is addressed when morality is the only law:
// account, listening, restitution, and a public record. Never a cage.
enum CircleOutcome {
  HARM_FOUND // the person the circle is about caused harm; lowers their standing
  NO_HARM // a misunderstanding or no fault; nobody loses standing
  UNFOUNDED // the accusation was false or malicious; lowers the raiser's standing
}

model Circle {
  id                String         @id @default(auto()) @map("_id") @db.ObjectId
  title             String
  account           String // what happened, in the raiser's words
  status            CircleStatus   @default(OPEN)
  outcome           CircleOutcome?
  locality          String
  lat               Float?
  lng               Float?
  keepersNeeded     Int            @default(3)
  declinedKeeperIds String[]       @default([])
  // Audit log of mediator draws: time, seed source (drand round or local),
  // the eligible pool, and who was drawn. Anyone can recompute each draw.
  drawLog           String[]       @default([])
  resolution        String? // what was agreed
  keeperIds         String[]       @default([]) // users holding the circle (not the parties)
  raisedById        String         @db.ObjectId
  aboutId           String?        @db.ObjectId
  createdAt         DateTime       @default(now())
  resolvedAt        DateTime?

  raisedBy User  @relation("CircleRaisedBy", fields: [raisedById], references: [id])
  about    User? @relation("CircleAbout", fields: [aboutId], references: [id])

  @@index([status, createdAt])
  @@index([aboutId])
  @@index([raisedById])
}

// --- Bulletins --------------------------------------------------------------

enum BulletinLevel {
  INFO
  HAZARD
  URGENT
}

model Bulletin {
  id        String        @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  body      String
  level     BulletinLevel @default(INFO)
  locality  String? // null: everywhere
  lat       Float? // null when posted everywhere
  lng       Float?
  authorId  String        @db.ObjectId
  createdAt DateTime      @default(now())
  expiresAt DateTime?

  author User @relation(fields: [authorId], references: [id])

  @@index([level, createdAt])
}

// --- Demurrage --------------------------------------------------------------

// Positive Grace decays slowly so it keeps moving. What decays is paid out as an
// equal dividend to every verified member; the rounding remainder is carried
// into the next run. Invariant: sum(user.graceBalance) + latest.remainder == 0.
model DemurrageRun {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  ranAt        DateTime @default(now())
  days         Int // elapsed days the decay covered
  rateMonthly  Float
  totalDecayed Int
  members      Int // verified members who received the dividend
  dividend     Int // per member
  remainder    Int // carried forward
}

enum AdjustmentReason {
  DEMURRAGE
  DIVIDEND
}

model LedgerAdjustment {
  id        String           @id @default(auto()) @map("_id") @db.ObjectId
  userId    String           @db.ObjectId
  ledger    Ledger
  amount    Int // signed
  reason    AdjustmentReason
  runId     String           @db.ObjectId
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// --- Assemblies: ranked-choice decisions ----------------------------------

model Proposal {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  title         String
  body          String
  options       String[] // at least two
  locality      String
  authorId      String    @db.ObjectId
  createdAt     DateTime  @default(now())
  closesAt      DateTime
  // A question about one shared thing, decided by the people in its record
  // rather than by the whole locality, and applied by the software itself when
  // voting closes (there is no one else to apply it). RULES replaces the
  // rules with proposedRules; STEWARD makes the winning candidate steward.
  commonsId     String?   @db.ObjectId
  commonsAction String? // "RULES" | "STEWARD"
  proposedRules String?
  candidateIds  String[]  @default([]) // STEWARD: candidateIds[i] stands behind options[i]; "" for "leave it as it is"
  appliedAt     DateTime?
  appliedNote   String? // what happened when it closed, in plain words

  // Secret ballots (src/lib/ballot-seal.ts): the rankings live here with no
  // person and no time, reshuffled on every write; who voted lives apart in
  // VoterRoll. Nothing stored links the two.
  sealedBallots SealedBallot[]

  author    User        @relation(fields: [authorId], references: [id])
  commons   Commons?    @relation(fields: [commonsId], references: [id])
  voterRoll VoterRoll[]

  @@index([locality, closesAt])
  @@index([commonsId])
}

// One secret ballot: a ranking and the fingerprint of a key only the voter's
// browser holds. No user id and no timestamp, on purpose.
type SealedBallot {
  fingerprint String // sha256 of the voter's ballot key, hex
  ranking     Int[] // option indices, most preferred first; may omit options
}

// That a person voted on a question, and nothing about how. It stops anyone
// voting twice and lets the page say "you have voted".
model VoterRoll {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  proposalId String @db.ObjectId
  userId     String @db.ObjectId

  proposal Proposal @relation(fields: [proposalId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@unique([proposalId, userId])
}

// After an exchange settles, each side may answer one question: did it leave
// you better off? Private per person, public only in aggregate, and it never
// touches standing. This is the community measuring what trade creates: the
// ledger sums to zero, wellbeing does not.
model Reflection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  listingId String   @db.ObjectId
  userId    String   @db.ObjectId
  delta     Int // -2 (much worse) .. 2 (much better)
  createdAt DateTime @default(now())

  listing Listing @relation(fields: [listingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([listingId, userId])
  @@index([createdAt])
}

// --- Seed bank & plant exchange --------------------------------------------

// Food security starts with locally-saved, open-pollinated seed. A seed share
// is one variety a grower offers to the community, gift-first, with the old
// ethic: take what you will plant, return seed at harvest so the bank grows.

enum SeedForm {
  SEED
  SEEDLING
  CUTTING
  TUBER
  BULB
  SCION
}

enum SeedCategory {
  VEGETABLE
  HERB
  FRUIT
  GRAIN
  FLOWER
  TREE
  COVER_CROP
  OTHER
}

model SeedShare {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  name           String // "Cherokee Purple tomato", "Scarlet runner bean"
  form           SeedForm     @default(SEED)
  category       SeedCategory
  description    String
  openPollinated Boolean? // true = saveable/heirloom, false = hybrid, null = unknown
  quantity       String? // "about 40 seeds", "3 seedlings"
  yearSaved      Int?
  daysToMaturity Int?
  sowMonths      Int[]        @default([]) // 1-12: when to sow locally
  locality       String?
  lat            Float?
  lng            Float?
  available      Boolean      @default(true)
  stewardId      String       @db.ObjectId
  createdAt      DateTime     @default(now())

  steward  User          @relation(fields: [stewardId], references: [id])
  requests SeedRequest[]

  @@index([category, available])
  @@index([stewardId])
}

enum SeedRequestStatus {
  REQUESTED // asked for seed
  GIVEN // handed over, now growing
  RETURNED // seed brought back at harvest - the bank grew
  DECLINED
}

model SeedRequest {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  seedShareId String            @db.ObjectId
  userId      String            @db.ObjectId
  message     String?
  status      SeedRequestStatus @default(REQUESTED)
  createdAt   DateTime          @default(now())
  returnedAt  DateTime?

  seedShare SeedShare @relation(fields: [seedShareId], references: [id])
  user      User      @relation(fields: [userId], references: [id])

  @@index([seedShareId])
  @@index([userId])
}

// --- Tamper-evident ledger ------------------------------------------------

// An append-only hash chain over every economic event (transfers, demurrage
// adjustments, voucher issue/redeem). Each entry commits to the one before it,
// so editing any past record breaks every hash after it and changes the root.
// Anyone can recompute the chain from the underlying records and check it.
model LedgerLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  kind        String // TRANSFER | ADJUSTMENT | VOUCHER_ISSUE | VOUCHER_REDEEM
  refId       String   @db.ObjectId
  payloadHash String // sha256 of the canonical event
  prevHash    String // hash of the previous entry (or the genesis constant)
  hash        String // sha256(prevHash + payloadHash)
  createdAt   DateTime @default(now())

  @@index([createdAt, id])
  @@index([refId])
}

// --- Offline vouchers (signed bearer notes) --------------------------------

// A voucher is the digital-and-printable "monopoly money with a signature": an
// offline bearer note the commons signs for a set amount, debited from the
// issuer up front. Anyone can verify the signature against the commons public
// key without a network. It is single-use: the nonce is consumed on redemption,
// so a photocopy is caught the second time. Double-spend is thus detectable,
// not prevented - the honest ceiling for offline value.
enum VoucherStatus {
  ISSUED
  REDEEMED
  VOIDED
}

model Voucher {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  issuerId     String        @db.ObjectId
  ledger       Ledger
  amount       Int
  nonce        String        @unique
  memo         String?
  signature    String // commons signature over the canonical token
  status       VoucherStatus @default(ISSUED)
  redeemedById String?       @db.ObjectId
  redeemedAt   DateTime?
  createdAt    DateTime      @default(now())

  issuer   User  @relation("VoucherIssuer", fields: [issuerId], references: [id])
  redeemer User? @relation("VoucherRedeemer", fields: [redeemedById], references: [id])

  @@index([issuerId])
  @@index([status])
}

// --- Cash: hash-commitment bearer notes ------------------------------------

// The most cash-like instrument here, and the most self-custodial. To mint a
// note the holder picks a secret in their own browser, hashes it with the
// denomination, and sends only the hash (commitment). The value is debited and
// "burned" into that commitment: locked, out of circulation. The holder writes
// the denomination and secret on paper. Whoever later reveals a secret whose
// hash matches an unspent commitment reclaims the value; the note is then spent
// and a copy is refused. Because the system only ever stores the hash, it
// cannot spend the note for anyone - not even a seized server can.
enum CashStatus {
  LOCKED
  SPENT
}

model CashNote {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  minterId     String     @db.ObjectId
  ledger       Ledger     @default(GRACE)
  denomination Int
  commitment   String     @unique // sha256("N1:" + denomination + ":" + secret)
  status       CashStatus @default(LOCKED)
  spentById    String?    @db.ObjectId
  spentAt      DateTime?
  createdAt    DateTime   @default(now())

  minter  User  @relation("CashMinter", fields: [minterId], references: [id])
  spender User? @relation("CashSpender", fields: [spentById], references: [id])

  @@index([minterId])
  @@index([status])
}

// --- Migrations -----------------------------------------------------------

// Records applied one-off data migrations so they never run twice.
model Migration {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique
  appliedAt DateTime @default(now())
}

// --- Other nodes (federation) -----------------------------------------------

// Another community's own copy of Freewill, known by its node key: the key
// that signs its ledger checkpoints and its bundles. Members here name it in
// their own words; there is no global registry of names. Nothing is taken in
// from it until enough verified members here have trusted it (PeerTrust),
// counted by the same rule as vouches. Peers are never deleted: a peer nobody
// trusts any more simply stops counting.
model Peer {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  name             String // what members here call it
  publicKey        String    @unique // its node key (Ed25519, hex), pinned when added
  url              String? // where its bundle is fetched from; none for a node met only by file
  addedById        String    @db.ObjectId
  createdAt        DateTime  @default(now())
  // The last bundle taken in: its signed time, when it arrived, and the root of
  // the ledger history it carried. A later bundle must carry the same history
  // and more; if it does not, historyChangedAt records when that was seen.
  lastBundleAt     DateTime?
  lastIngestAt     DateTime?
  checkpointRoot   String?
  checkpointCount  Int?
  checkpointAt     DateTime?
  historyChangedAt DateTime?
  // Their books as they reported them (aggregates only), for a person to read.
  books            Json?

  addedBy User         @relation(fields: [addedById], references: [id])
  trust   PeerTrust[]
  members PeerMember[]
  records PeerRecord[]
  ingests PeerIngest[]
}

// One member's trust in another node: "I have checked this node's key with
// someone there, and I am willing to see what it publishes here." Public, like
// a vouch, and withdrawn the same way.
model PeerTrust {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  peerId    String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  peer Peer @relation(fields: [peerId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([peerId, userId])
  @@index([userId])
}

// A member of another node who wrote something that travelled, or who holds a
// key. Username, locality and public key only, as that node sent them.
// signedVouches counts vouches for them whose signatures checked out here.
model PeerMember {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  peerId        String    @db.ObjectId
  remoteId      String
  username      String
  locality      String
  publicKey     String?
  signedVouches Int       @default(0)
  seenAt        DateTime  @default(now())
  goneAt        DateTime? // no longer in that node's latest bundle

  peer Peer @relation(fields: [peerId], references: [id])

  @@unique([peerId, remoteId])
}

enum PeerRecordKind {
  LISTING
  BULLETIN
  COMMONS
  SEED
}

// A copy of something another node published: a need or offer, a notice, a
// shared thing, a seed. Read-only here and always shown with that node's name.
// `data` is the record exactly as validated on the way in (federation.shared.ts);
// `digest` detects a change. A record that drops out of a later bundle is
// marked gone rather than deleted, so the page can say it was withdrawn.
model PeerRecord {
  id             String         @id @default(auto()) @map("_id") @db.ObjectId
  peerId         String         @db.ObjectId
  kind           PeerRecordKind
  remoteId       String
  authorRemoteId String
  category       String?
  locality       String?
  lat            Float? // rounded to about a kilometer before it left that node
  lng            Float?
  data           Json
  digest         String
  firstSeenAt    DateTime       @default(now())
  changedAt      DateTime       @default(now())
  goneAt         DateTime?

  peer Peer @relation(fields: [peerId], references: [id])

  @@unique([peerId, kind, remoteId])
  @@index([kind, peerId])
}

// Every bundle a trusted node sent, and what happened to it: taken in, already
// had it, or refused with the reason. Append-only. Bundles signed by a key no
// member here has added are refused without a row, so strangers cannot fill it.
model PeerIngest {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  peerId     String    @db.ObjectId
  via        String // "push" | "pull" | "file"
  byId       String?   @db.ObjectId // the member who fetched it or brought the file
  bundleAt   DateTime?
  outcome    String // "accepted" | "stale" | "refused"
  note       String // plain words
  counts     Json?
  root       String?
  entries    Int?
  receivedAt DateTime  @default(now())

  peer Peer  @relation(fields: [peerId], references: [id])
  by   User? @relation(fields: [byId], references: [id])

  @@index([peerId, receivedAt])
}
