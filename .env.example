# Databases. The app picks by NODE_ENV: `next dev` uses DATABASE_URL_DEV, `next start` (and
# `next build`) uses DATABASE_URL_PROD. Prisma needs a REPLICA SET (the ledger uses transactions).
#  - Local (npm run db:local, or docker compose up -d):  mongodb://localhost:27018/freewill?replicaSet=rs0&directConnection=true
#  - Atlas (already a replica set):                     mongodb+srv://user:pass@cluster.mongodb.net/freewill
DATABASE_URL_DEV="mongodb://localhost:27018/freewill?replicaSet=rs0&directConnection=true"
DATABASE_URL_PROD="mongodb+srv://user:pass@cluster.mongodb.net/freewill"

# What the Prisma CLI (db push, seed, studio, rs-init) targets. Keep it on the dev
# database; `npm run db:push:prod` points the CLI at DATABASE_URL_PROD for you.
DATABASE_URL="mongodb://localhost:27018/freewill?replicaSet=rs0&directConnection=true"

# Optional: map tile server (default is OpenStreetMap over the internet).
# NEXT_PUBLIC_TILE_URL="http://localhost:8080/tiles/{z}/{x}/{y}.png"

# Signs session cookies. Any long random string. Rotate it to log everyone out.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Optional ID.me attestation (attestation only, never login; off by default).
# Effect: one extra vouch toward local verification, nothing else. We store a
# date and an HMAC of the ID.me subject id, never a name or document.
# Register at developers.id.me; sandbox host is api.idmelabs.com.
IDME_ENABLED="false"
IDME_CLIENT_ID=""
IDME_CLIENT_SECRET=""
IDME_REDIRECT_URI="http://localhost:3000/api/idme/callback"
IDME_API_BASE="https://api.idmelabs.com"
IDME_SCOPE="openid"
