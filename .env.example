# Databases. The app picks by NODE_ENV: `next dev` uses DATABASE_URL_DEV, `next start` (and
# `next build`) uses DATABASE_URL_PROD. Prisma needs a REPLICA SET (the ledger uses transactions).
#  - Local (npm run db:local, or docker compose up -d):  mongodb://localhost:27018/freewill?replicaSet=rs0&directConnection=true
#  - Atlas (already a replica set):                     mongodb+srv://user:pass@cluster.mongodb.net/freewill
DATABASE_URL_DEV="mongodb://localhost:27018/freewill?replicaSet=rs0&directConnection=true"
DATABASE_URL_PROD="mongodb+srv://user:pass@cluster.mongodb.net/freewill"

# What the Prisma CLI (db push, seed, studio, rs-init) targets. Keep it on the dev
# database; `npm run db:push:prod` points the CLI at DATABASE_URL_PROD for you.
DATABASE_URL="mongodb://localhost:27018/freewill?replicaSet=rs0&directConnection=true"

# Maps. Preferred: a self-hosted vector map file (PMTiles) drawn as outlines in the
# person's own theme colors; see docs/maps.md for how to make one for your area.
# Serve it from public/map/ or any host that supports HTTP range requests.
# NEXT_PUBLIC_PMTILES_URL="/map/local.pmtiles"
# Fallback: raster tiles (default is OpenStreetMap over the internet, whose
# usage policy does not allow a busy app; set your own before scale).
# NEXT_PUBLIC_TILE_URL="http://localhost:8080/tiles/{z}/{x}/{y}.png"

# Signs session cookies. Any long random string, 32+ characters. Rotate it to log everyone out.
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Seeds the commons signing key (vouchers, ledger checkpoints). Keep it stable so
# exported checkpoints stay verifiable even if SESSION_SECRET rotates. Unset, it
# falls back to SESSION_SECRET.
COMMONS_KEY_SEED=""

# Optional ID.me attestation (attestation only, never login; off by default).
# Effect: one extra vouch toward local verification, nothing else. We store a
# date and an HMAC of the ID.me subject id, never a name or document.
# Register at developers.id.me; sandbox host is api.idmelabs.com.
IDME_ENABLED="false"
IDME_CLIENT_ID=""
IDME_CLIENT_SECRET=""
IDME_REDIRECT_URI="http://localhost:3000/api/idme/callback"
IDME_API_BASE="https://api.id.me"
IDME_POLICIES="nurse,responder,teacher,government"

# Infrastructure tip jar (kept entirely separate from Grace; never a way to buy credit).
# A donation page URL (Open Collective, Ko-fi, GitHub Sponsors, a Stripe donation link).
SUPPORT_URL=""
SUPPORT_NOTE="Hosting, the database, and the map tiles."

# Optional, maintainers only: lets `npm run audit:claims` ask TypeSafe System One
# whether the claims on /about are honestly stated. Never used by the app itself,
# and nothing at runtime consults a model. Without it the audit still runs its
# deterministic half and writes the questions out for running elsewhere.
TYPESAFE_API_KEY=""

# Optional: the onion address of this node, when Tor runs beside the app
# (docs/onion.md). Pages on the regular address then offer it to Tor Browser,
# and visits through it are handled over plain http inside Tor. Leave empty
# for none; a mistyped address is ignored (its checksum fails).
ONION_HOSTNAME=""
